# BFF 监听端口
PORT=3000

# 阶段 5A-2 与 5B 将使用；本阶段不会读取
AMAP_WEB_SERVICE_KEY=
AMAP_SECURITY_JS_CODE=

# 阶段 6A：仅 BFF 读取；浏览器不得访问
AI_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
# 千问服务端请求超时，单位毫秒；仅 BFF 读取
QWEN_REQUEST_TIMEOUT_MS=60000

# 前端需求提取来源：mock（默认）或 bff
VITE_TRIP_AI_MODE=mock

# 前端行程生成来源：mock（默认）或 bff；与需求提取模式相互独立
VITE_TRIP_GENERATION_MODE=mock
